<UserControl x:Class="MoneyCreator.View.PopBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoneyCreator.View"
             mc:Ignorable="d" 
     Background="#80000000">
    <!-- 반투명 배경 -->
    <Grid Background="#80000000">
        <Border Background="White" CornerRadius="12" Width="320" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Effect="{StaticResource PopBoxShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 메시지 영역 -->
                    <RowDefinition Height="50"/>
                    <!-- 버튼 영역 -->
                </Grid.RowDefinitions>

                <!-- 메시지 영역 -->
                <StackPanel Grid.Row="0" Margin="25,30,25,25">
                    <TextBlock x:Name="TxtMessage" Text="메시지 내용" TextWrapping="Wrap" 
                               FontSize="15" LineHeight="22" TextAlignment="Center"
                               Foreground="#333333" HorizontalAlignment="Center"/>

                    <!-- Alert용 진행바 -->
                    <ProgressBar x:Name="AutoCloseProgress" Height="3" Margin="0,15,0,0" 
                                 Visibility="Collapsed" Maximum="100" Foreground="#007ACC" Background="#F0F0F0" BorderThickness="0"/>
                </StackPanel>

                <!-- 하단 버튼 영역 (UniformGrid로 꽉 채움) -->
                <UniformGrid Grid.Row="1" x:Name="ButtonGrid" Columns="2" Margin="0,0,0,10">
                    <Button x:Name="BtnConfirm" Content="확인"
                            Click="BtnConfirm_Click"
                            Background="#F5F5F5" Foreground="#007ACC" FontWeight="Bold" BorderThickness="0,1,0,0" BorderBrush="#EEEEEE"/>
                    <Button x:Name="BtnCancel" Content="취소" 
                            Click="BtnCancel_Click" Visibility="Collapsed"
                            Background="#F5F5F5" Foreground="#666666" BorderThickness="0,1,0,0" BorderBrush="#EEEEEE"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
