<UserControl x:Class="MoneyCreator.View.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="Transparent">
    <Grid Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border Background="White" CornerRadius="12" Width="420" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Effect="{StaticResource PopBoxShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="25,30,25,25">
                    <TextBlock x:Name="TxtName" Text="종목명" FontSize="18" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtOrderNo" Text="주문번호: 000000" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <StackPanel Margin="5">
                            <TextBlock Text="구분" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtType" Text="매수" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="현재상태" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtStatus" Text="접수" FontSize="14" Foreground="#007ACC"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="원주문가격" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtOrigPrice" Text="0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="원주문수량" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtOrigQty" Text="0" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="체결수량" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtExecQty" Text="0" FontSize="14" Foreground="#2E7D32"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="미체결수량" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TxtUntradedQty" Text="0" FontSize="14" FontWeight="Bold" Foreground="#C62828"/>
                        </StackPanel>
                    </UniformGrid>

                    <Separator Background="#EEEEEE" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="5,0">
                            <TextBlock Text="정정 가격" FontSize="11" Foreground="#007ACC" Margin="0,0,0,5"/>
                            <TextBox x:Name="EditPrice" FontSize="16" FontWeight="Bold" Padding="8,5" 
                                     TextAlignment="Right" Background="#F9F9F9" BorderThickness="0,0,0,2" BorderBrush="#007ACC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="정정 수량" FontSize="11" Foreground="#007ACC" Margin="0,0,0,5"/>
                            <TextBox x:Name="EditQty" FontSize="16" FontWeight="Bold" Padding="8,5" 
                                     TextAlignment="Right" Background="#F9F9F9" BorderThickness="0,0,0,2" BorderBrush="#007ACC"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                    <Button x:Name="BtnConfirm" Content="정정 실행" Click="BtnConfirm_Click"
                            Background="#F5F5F5" Foreground="#007ACC" FontWeight="Bold" BorderThickness="0,1,0,0" BorderBrush="#EEEEEE"/>
                    <Button x:Name="BtnCancel" Content="취소" Click="BtnCancel_Click"
                            Background="#F5F5F5" Foreground="#666666" BorderThickness="0,1,1,0" BorderBrush="#EEEEEE"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>