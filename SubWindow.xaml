<Window x:Class="MoneyCreator.SubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoneyCreator.ViewModels"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MoneyCreator - AI Auto Trading" Height="950" Width="1500"
        WindowStartupLocation="CenterScreen" Background="#121212">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <wf:WindowsFormsHost x:Name="APIHost" 
                     Visibility="Visible" 
                     Width="1" Height="1" 
                     Opacity="0" 
                     HorizontalAlignment="Left" 
                     VerticalAlignment="Top" />

        <Border Grid.Row="0" Background="#1E1E1E" Padding="12" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="MONEY CREATOR" Foreground="Gold" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="서버 연결" Command="{Binding ConnectCommand}" Width="90" Height="32" Margin="5"/>
                    <Button Content="AI 재탐색" Command="{Binding SearchCommand}" Width="100" Height="32" Margin="5" Background="#f1c40f" Foreground="Black" FontWeight="Bold"/>
                    <Button Content="분석 시작" Command="{Binding AnalyzeCommand}" Width="100" Height="32" Margin="5" Background="#27ae60" Foreground="White"/>
                    <Button Content="시작" Command="{Binding StartCommand}" Width="100" Height="32" Margin="5" Background="#27ae60" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#444" BorderThickness="1" Margin="5" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedSymbol}" 
                              AutoGenerateColumns="False" Background="#1A1A1A" RowHeaderWidth="0" 
                              GridLinesVisibility="None" BorderThickness="0" CanUserAddRows="False" Foreground="Black" Cursor="">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="종목명" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="현재가" Binding="{Binding Price}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#121212"/>

                <Border Grid.Row="2" BorderBrush="Gold" BorderThickness="1.5" Margin="5" Background="#1A1A1A">
                    <DataGrid ItemsSource="{Binding AiSelectedSymbols}" AutoGenerateColumns="False" RowHeaderWidth="0" GridLinesVisibility="None" Background="#1A1A1A" Foreground="Black">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="종목명" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="강도" Binding="{Binding Reason}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#222"/>

            <Border Grid.Column="2" Background="Black" Margin="5">
                <TextBlock Text="CHART AREA" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#222"/>

            <Border Grid.Column="4" Background="#1A1A1A" Margin="5" BorderBrush="#333" BorderThickness="1"/>
        </Grid>

        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#333" BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" Foreground="#00FF00" FontFamily="Consolas" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>