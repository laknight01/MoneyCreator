<Window x:Class="MoneyCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoneyCreator.ViewModels"
        xmlns:uc="clr-namespace:MoneyCreator.View"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:converters="clr-namespace:MoneyCreator.Converters"
        Title="Money Creator - AI Auto Trading" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen" Background="#121212">
    <Window.Resources>
        <converters:PriceToColorConverter x:Key="PriceToColorConverter"/>
        <converters:StrengthToColorConverter x:Key="StrengthToColorConverter"/>

    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <wf:WindowsFormsHost x:Name="APIHost" 
                     Visibility="Visible" 
                     Width="1" Height="1" 
                     Opacity="0" 
                     HorizontalAlignment="Left" 
                     VerticalAlignment="Top" />
        <uc:PopBox x:Name="MessagePopup" Visibility="Collapsed"/>
        <Border Grid.Row="0"
                Background="#151515"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="8,5"
                Margin="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="203"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" >
                        <TextBlock Text="Trade Performance"
                               Foreground="#FF5252"
                               FontSize="13"
                               FontWeight="Bold"/>
                        <TextBlock Text="{Binding TradePerformanceStatusText}"
                               Foreground="#BBBBBB"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding PerformanceLastUpdatedText, StringFormat=갱신 {0}}"
                               Foreground="#777777"
                               FontSize="10"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="오늘 손익" Foreground="#AFAFAF" FontSize="11"/>
                        <TextBlock Text="{Binding TodayNetProfit, StringFormat={}{0:N0}원}" Foreground="#F2F2F2" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TodayFeeTax, StringFormat=수수료/세금 {0:N0}원}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="오늘 매매" Foreground="#AFAFAF" FontSize="11"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayTradeCount, StringFormat=총 {0:N0}건}" Foreground="#F2F2F2" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="  /  " Foreground="#666666"/>
                            <TextBlock Text="{Binding TodayWinRate, StringFormat=승률 {0:F1}%}" Foreground="#F2F2F2" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Foreground="#888888" FontSize="10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="승 {0:N0} / 패 {1:N0}">
                                    <Binding Path="TodayWinCount"/>
                                    <Binding Path="TodayLossCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="오늘 품질" Foreground="#AFAFAF" FontSize="11"/>
                        <TextBlock Text="{Binding TodayAvgProfitRate, StringFormat=평균 {0:F2}%}" Foreground="#F2F2F2" FontSize="13" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayBestTradeRate, StringFormat=최고 {0:F2}%}" Foreground="#E05A5A" FontSize="10"/>
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding TodayWorstTradeRate, StringFormat=최저 {0:F2}%}" Foreground="#5A8CFF" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="총 누적" Foreground="#AFAFAF" FontSize="11"/>
                        <TextBlock Text="{Binding TotalNetProfit, StringFormat={}{0:N0}원}" Foreground="#F2F2F2" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Foreground="#888888" FontSize="10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="총 {0:N0}건 / 승률 {1:F1}% / 평균 {2:F2}%">
                                    <Binding Path="TotalTradeCount"/>
                                    <Binding Path="TotalWinRate"/>
                                    <Binding Path="TotalAvgProfitRate"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Background="#1F1F1F" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="오늘 손익 분해" Foreground="#AFAFAF" FontSize="11"/>
                        <TextBlock Text="{Binding TodayGrossProfit, StringFormat=총수익 {0:N0}원}" Foreground="#E05A5A" FontSize="11"/>
                        <TextBlock Text="{Binding TodayGrossLoss, StringFormat=총손실 {0:N0}원}" Foreground="#5A8CFF" FontSize="11"/>
                        <TextBlock Text="{Binding TodayFeeTax, StringFormat=비용 {0:N0}원}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#1E1E1E" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Money Creator"
                       Foreground="#FF5252"
                       FontSize="21"
                       FontWeight="ExtraBold"
                       Opacity="0.6"
                       VerticalAlignment="Center"
                       Margin="20,0"
                       FontFamily="Georgia Pro"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="0,10">
                <TextBox x:Name="SearchBox"
                         Width="200"
                         Height="30"
                         Margin="5"
                         VerticalContentAlignment="Center"
                         Background="#2A2A2A"
                         Foreground="White"
                         BorderBrush="#444"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         KeyDown="SearchBox_KeyDown"/>

                <Button Content="🔍 검색"
                        Command="{Binding SearchCommand}"
                        Width="80"
                        Height="30"
                        Margin="5"/>

                <Popup IsOpen="{Binding IsSearchPopupOpen}"
                       PlacementTarget="{Binding ElementName=SearchBox}"
                       StaysOpen="False">
                    <Border Background="#2A2A2A"
                            BorderBrush="Gold"
                            BorderThickness="1"
                            Width="{Binding ElementName=SearchBox, Path=ActualWidth}">
                        <ListBox x:Name="SearchListBox"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedSearchSymbol, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Background="#1A1A1A"
                                 Foreground="White"
                                 Focusable="False"
                                 MouseLeftButtonUp="SearchListBox_MouseClick">
                            <ListBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                            </ListBox.Resources>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Tag"
                                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        Padding="5">
                                                    <ContentPresenter/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="Gold"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#333333"/>
                                                    </Trigger>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#444444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Popup>

                <!--<Button Content="관심 추가"
                        Command="{Binding AddWatchlistCommand}"
                        Width="80"
                        Height="30"
                        Margin="5"/>-->
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,10,10,10">
                <TextBlock Text="계좌:"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <ComboBox ItemsSource="{Binding AccountList}"
                          SelectedItem="{Binding SelectedAccount}"
                          Width="100"
                          Height="30"
                          Background="#2A2A2A"
                          Foreground="Black"
                          BorderBrush="#444"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="예수금:"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           Margin="15,0,5,0"/>

                <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:N0}원}"
                           Foreground="#00FF00"
                           FontSize="14"
                           FontWeight="Bold"
                           Width="120"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"/>

                <TextBlock Text="{Binding CurrentSymbolAllocationText}"
                           Foreground="#FFD966"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Width="280"
                           VerticalAlignment="Center"
                           Margin="0,0,40,0"/>

                <Button Content="연결"
                        Command="{Binding ConnectCommand}"
                        Width="70"
                        Height="30"
                        Margin="0,0,5,0"/>

                <Button Content="📅 전체 보유종목"
                        Command="{Binding OpenAllHoldingsCommand}"
                        Width="140"
                        Height="30"
                        Margin="0,0,5,0"
                        ToolTip="현재 보유 중인 모든 종목을 개별 창으로 띄웁니다 (중복 제외)"/>

                <Button Content="📅새창"
                        Command="{Binding AiToggleCommand}"
                        Width="90"
                        Height="30"
                        Margin="0,0,50,0"
                        ToolTip="종목이 지정되지 않은 새 창을 하나 더 띄웁니다"/>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Auto"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                  IsChecked="{Binding IsAutoTradingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Small"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                  IsChecked="{Binding IsAutoTradingSmallScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Replay"
                               Foreground="#9FE6FF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ToggleButton Style="{StaticResource SwitchToggleStyle}"
                                  IsChecked="{Binding IsReplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="ReplayData_yyyyMMdd.db 데이터를 LocalReplayApiService로 실시간처럼 주입합니다."/>
                </StackPanel>

                <!--<StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="분석로그"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ComboBox Width="85"
                              Height="26"
                              ItemsSource="{Binding AutoTradeLogModeOptions}"
                              SelectedItem="{Binding SelectedAutoTradeLogMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Background="#222"
                              Foreground="White"
                              BorderBrush="#555"/>
                </StackPanel>-->
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="121"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!--검색 List-->
                <Border DataContext="{Binding Context}" Padding="10,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Name, FallbackValue='연결안됨'}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Code, FallbackValue='연결안됨'}" FontSize="12" Foreground="Gray"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="현재가: " FontSize="12" Foreground="Gray"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LastPrice, StringFormat={}{0:N0}}" 
               Foreground="{Binding ChangeRate, Converter={StaticResource PriceToColorConverter}}"
               FontWeight="Bold"/>

                                <TextBlock Text="{Binding DisplayChangeText}" 
               Foreground="{Binding ChangeRate, Converter={StaticResource PriceToColorConverter}}"
               Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="체결강도 " FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strength, StringFormat={}{0:N2}%}" 
               FontSize="12"
               FontWeight="Bold" 
               VerticalAlignment="Center"
               Foreground="{Binding Strength, Converter={StaticResource StrengthToColorConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center" Visibility="{Binding IsHolding, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- 보유 중일 때만 표시 -->
                            <!-- 1. 수량 -->
                            <TextBlock Text="잔고: " FontSize="12" Foreground="#888"/>
                            <TextBlock Text="{Binding CurrentHold.Quantity, StringFormat={}{0:N0}주}" 
                   FontSize="12" Foreground="#EEE" FontWeight="Bold" Margin="0,0,5,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center" Visibility="{Binding IsHolding, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- 2. 가격 (매입가 -> 현재가) -->
                            <TextBlock Text="평단: " FontSize="12" Foreground="#888"/>
                            <TextBlock Text="{Binding CurrentHold.EntryPrice, StringFormat={}{0:N0}}" 
                   FontSize="12" Foreground="#BBB" Margin="0,0,2,0"/>

                            <TextBlock Text="▶" FontSize="10" Foreground="#555" VerticalAlignment="Center" Margin="0,0,2,0"/>

                            <TextBlock Text="{Binding CurrentHold.CurrentPrice, StringFormat={}{0:N0}}" 
                   FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>

                            <!-- 3. 수익률 -->
                            <Border Padding="2,0,2,2" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentHold.IsProfit}" Value="True">
                                                <Setter Property="Background" Value="#33FF4444"/>
                                                <!-- 연한 빨강 배경 -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentHold.IsLoss}" Value="True">
                                                <Setter Property="Background" Value="#334444FF"/>
                                                <!-- 연한 파랑 배경 -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentHold.ProfitRate, StringFormat={}{0:P2}}"
                       FontSize="13" FontWeight="ExtraBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#AAA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentHold.IsProfit}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentHold.IsLoss}" Value="True">
                                                    <Setter Property="Foreground" Value="#4444FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- 미보유 시 -->
                        <TextBlock Text="미보유 종목" Visibility="{Binding IsHolding, Converter={StaticResource InverseBooleanToVisibilityConverter}}" FontSize="12" Foreground="#444" Margin="5,0"/>
                    </StackPanel>
                </Border>
                <!--자동매매 분석 카드-->
                <Border Grid.Row="1"
                        Margin="0,5,0,3"
                        CornerRadius="12"
                        Background="{Binding TradeCardAccentBrush, FallbackValue=#243447}"
                        BorderThickness="0"
                        Padding="10" HorizontalAlignment="Center" Width="191">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="3"
                                          Opacity="0.35"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- 시장상태 -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock Text="자동매매 분석"
                                       Foreground="#EAF5FF"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.9"
                                       DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TradeCardUpdatedAt}"
                                       Foreground="#EAF5FF"
                                       FontSize="11"
                                       Opacity="0.8"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding TradeCardTitle}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            
                            <TextBlock Text="{Binding TradeCardAction}"
                                       Foreground="{Binding TradeCardActionBrush}"
                                       FontSize="18"
                                       FontWeight="ExtraBold"/>
                            <TextBlock Text="  ·  "
                                       Foreground="#DCEEFF"
                                       FontSize="15"
                                       Opacity="0.85"/>
                            <TextBlock Text="{Binding TradeCardCode}"
                                       Foreground="#DCEEFF"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,5,0,0">
                                <TextBlock Text="시장상태" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardPhase}" Foreground="#FFD966" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,5,0,0">
                                <TextBlock Text="종목국면" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardMarketPhase}" Foreground="#FFD966" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="4" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="현재가" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardPrice}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="수익률" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardProfitRate}" Foreground="{Binding TradeCardProfitBrush}" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="점수" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardScore}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="보유수량" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardHoldingQty}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="체결강도" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardStrength}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="거래량비율" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardVolumeRatio}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="매수우위" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardBidAskRatio}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="매매모드" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding TradeCardTradeMode}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="5" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="가격변화율 / BAR 충전율" Foreground="#CDE7FF" FontSize="11" Opacity="0.85"/>
                                    <TextBlock Foreground="White" FontSize="13">
