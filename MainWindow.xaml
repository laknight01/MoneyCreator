                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <!-- PriceToColorConverter가 ProfitRate(double)를 받아서 처리하도록 바인딩 -->
                                                        <Setter Property="Foreground" Value="{Binding ProfitRate, Converter={StaticResource PriceToColorConverter}}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="데이터" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <ProgressBar Width="45"
                                                                     Height="8"
                                                                     IsIndeterminate="True"
                                                                     Margin="0,0,6,0"
                                                                     Visibility="{Binding IsHistoryLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding HistoryStatusText}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <!-- 2. 주문내역 탭 -->
                                <TabItem Header="주문내역" Width="100">
                                    <DataGrid ItemsSource="{Binding OrderHistory}" AutoGenerateColumns="False" 
                      IsReadOnly="True" Background="#1A1A1A" Foreground="#1A1A1A" BorderThickness="0" GridLinesVisibility="None">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="시간" Binding="{Binding OrderTime}" Width="80"/>
                                            <DataGridTextColumn Header="종목" Binding="{Binding Name}" Width="150"/>
                                            <DataGridTextColumn Header="구분" Binding="{Binding OrderType}" Width="80"/>
                                            <DataGridTextColumn Header="가격" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="80"/>
                                            <DataGridTextColumn Header="주문수량" Binding="{Binding Qty}" Width="60"/>
                                            <DataGridTextColumn Header="체결가격" Binding="{Binding ExecPrice, StringFormat={}{0:N0}}" Width="80"/>
                                            <DataGridTextColumn Header="체결수량" Binding="{Binding ExecQty}" Width="80"/>
                                            <DataGridTextColumn Header="미체결수량" Binding="{Binding UntradedQty}" Width="80"/>
                                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="70"/>
                                            <!-- 버튼 컬럼 추가 -->
                                            <DataGridTemplateColumn Header="관리" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="정정"
                                                                    Command="{Binding DataContext.ModifyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="2"
                                                                    Padding="5,1"
                                                                    Background="#2E7D32"
                                                                    Foreground="White"
                                                                    FontSize="11">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Received">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Confirmed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="PartiallyFilled">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding UntradedQty}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="FullyFilled">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Rejected">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Corrected">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <Button Content="취소"
                                                                    Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="2"
                                                                    Padding="5,1"
                                                                    Background="#C62828"
                                                                    Foreground="White"
                                                                    FontSize="11">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Received">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Confirmed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="PartiallyFilled">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding UntradedQty}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="FullyFilled">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Rejected">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Corrected">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <!-- 3. 프로그램매매 탭 -->
                                <TabItem Header="프로그램매매" Width="100">
                                    <Grid Background="#1A1A1A">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Background="#202020"
                                                BorderBrush="#333333"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,4">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="상태 " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.FlowDirection, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Text="점수 " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.FlowScore, StringFormat={}{0:N1}, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="11"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Text="Δ1m " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.Delta1mAmount, StringFormat={}{0:+#,##0;-#,##0;0}, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="11"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Text="Δ5m " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.Delta5mAmount, StringFormat={}{0:+#,##0;-#,##0;0}, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="11"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Text="Δ10m " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.Delta10mAmount, StringFormat={}{0:+#,##0;-#,##0;0}, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="11"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Text="WarmUp " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding LatestProgramFlowSnapshot.IsWarmedUp, TargetNullValue=-}"
                                                               Foreground="#EEEEEE"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding ProgramTrades}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  Background="#1A1A1A"
                                                  Foreground="#EEEEEE"
                                                  BorderThickness="0"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#333333"
                                                  RowBackground="#1A1A1A"
                                                  AlternatingRowBackground="#222222"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#2A2A2A"/>
                                                    <Setter Property="Foreground" Value="#DDDDDD"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderBrush" Value="#444444"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                                    <Setter Property="BorderBrush" Value="#333333"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                                    <Setter Property="Padding" Value="4,1"/>
                                                </Style>
                                                <Style x:Key="ProgramTradeRightTextStyle" TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                                </Style>
                                                <Style x:Key="ProgramTradeCenterTextStyle" TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="시간"
                                                                    Binding="{Binding TradeTime, StringFormat={}{0:HH:mm:ss}}"
                                                                    ElementStyle="{StaticResource ProgramTradeCenterTextStyle}"
                                                                    Width="80"/>
                                                <DataGridTextColumn Header="소스"
                                                                    Binding="{Binding Source}"
                                                                    ElementStyle="{StaticResource ProgramTradeCenterTextStyle}"
                                                                    Width="75"/>
                                                <DataGridTextColumn Header="방향"
                                                                    Binding="{Binding Direction}"
                                                                    ElementStyle="{StaticResource ProgramTradeCenterTextStyle}"
                                                                    Width="70"/>
                                                <DataGridTextColumn Header="현재가"
                                                                    Binding="{Binding CurrentPrice, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="90"/>
                                                <DataGridTextColumn Header="순매수금액"
                                                                    Binding="{Binding DisplayNetAmount, StringFormat={}{0:+#,##0;-#,##0;0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="Δ금액"
                                                                    Binding="{Binding DisplayNetAmountDelta, StringFormat={}{0:+#,##0;-#,##0;0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="100"/>
                                                <DataGridTextColumn Header="매수금액"
                                                                    Binding="{Binding ProgramBuyAmount, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="110"/>
                                                <DataGridTextColumn Header="매도금액"
                                                                    Binding="{Binding ProgramSellAmount, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="110"/>
                                                <DataGridTextColumn Header="순매수수량"
                                                                    Binding="{Binding DisplayNetQuantity, StringFormat={}{0:+#,##0;-#,##0;0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="100"/>
                                                <DataGridTextColumn Header="Δ수량"
                                                                    Binding="{Binding DisplayNetQuantityDelta, StringFormat={}{0:+#,##0;-#,##0;0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="90"/>
                                                <DataGridTextColumn Header="매수수량"
                                                                    Binding="{Binding ProgramBuyQuantity, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="95"/>
                                                <DataGridTextColumn Header="매도수량"
                                                                    Binding="{Binding ProgramSellQuantity, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="95"/>
                                                <DataGridTextColumn Header="거래량"
                                                                    Binding="{Binding Volume, StringFormat={}{0:N0}}"
                                                                    ElementStyle="{StaticResource ProgramTradeRightTextStyle}"
                                                                    Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="#0A0A0A" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="5">
            <ListBox x:Name="MainLogListBox"
                     ItemsSource="{Binding Logs}"
                     SelectionMode="Extended"
                     Focusable="True"
                     PreviewKeyDown="MainLogListBox_PreviewKeyDown"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Background="Transparent"
                     Foreground="#00FF00"
                     FontFamily="Consolas"
                     BorderThickness="0">
            </ListBox>
        </Border>
        <Border Grid.RowSpan="4"
      Background="#AA000000"
      Visibility="{Binding IsMainLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
      Panel.ZIndex="9999">
            <Grid>
                <Border Width="420"
              Height="150"
              Background="#1E1E1E"
              BorderBrush="#555"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="25">
                    <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                        <TextBlock Text="데이터 로딩 중"
                         Foreground="White"
                         FontSize="22"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding MainLoadingMessage}"
                         Foreground="#CCCCCC"
                         FontSize="14"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"/>

                        <TextBlock Text="잠시만 기다려주세요."
                         Foreground="#888888"
                         FontSize="12"
                         HorizontalAlignment="Center"
                         Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>